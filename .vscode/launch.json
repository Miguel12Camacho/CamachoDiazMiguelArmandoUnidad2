{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Iniciar servidor (Node)",
            "program": "${workspaceFolder}/server.js",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Abrir en Edge (localhost:3000)",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/public"
        }
    ],
    "compounds": [
        {
            "name": "Servidor + Edge",
            "configurations": ["Iniciar servidor (Node)", "Abrir en Edge (localhost:3000)"]
        }
    ]
}
